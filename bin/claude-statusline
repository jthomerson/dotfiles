#!/usr/bin/env bash
#
# Claude Code status line: the account, the model, how much of the context is used, and
# how much of the 5-hour and 7-day usage limits is gone, with when each resets, plus a link
# to the merge request when the session is in a review worktree. Claude Code runs it with
# the session's JSON on stdin. The session's cost sits at the right edge.

set -euo pipefail

input=$(cat)

# Claude Code indents the status line by an amount the script can't read, so stop short of
# the edge to keep the cost from wrapping
RIGHT_MARGIN=4

get_field() {
   jq -r "$1 // empty" <<< "$input"
}

# Green under 50%, yellow under 80%, red from there
color_percent() {
   local percent="$1"

   if [ "$percent" -ge 80 ]; then
      printf '\033[31m%s%%\033[0m' "$percent"
      return
   fi
   if [ "$percent" -ge 50 ]; then
      printf '\033[33m%s%%\033[0m' "$percent"
      return
   fi
   printf '\033[32m%s%%\033[0m' "$percent"
}

# " · 5h 23% (resets 3:10pm)", or nothing when the account has no such limit
describe_limit() {
   local label="$1" window="$2" format="$3" percent resets_at

   percent=$(get_field ".rate_limits.$window.used_percentage")
   resets_at=$(get_field ".rate_limits.$window.resets_at")
   [ -n "$percent" ] || return 0
   printf ' · %s %s' "$label" "$(color_percent "${percent%.*}")"
   if [ -n "$resets_at" ]; then
      printf ' (resets %s)' "$(/bin/date -r "$resets_at" "+$format" | sed 's/AM$/am/; s/PM$/pm/')"
   fi
}

# " · !5180" linked to the merge request, when the directory is a review worktree, which
# the worktrees skill names review-<author>-<number>-<description>. Reads the name and
# the git remote instead of asking GitLab, so the status line stays fast.
describe_review() {
   local dir="$1" worktree number remote project url

   worktree=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return 0
   [[ "$(basename "$worktree")" =~ ^review-[^-]+-([0-9]+)- ]] || return 0
   number="${BASH_REMATCH[1]}"
   remote=$(git -C "$worktree" remote get-url origin 2>/dev/null) || return 0
   [[ "$remote" =~ ^git@([^:]+):(.+)\.git$ ]] || return 0
   project="${BASH_REMATCH[2]}"
   url="https://${BASH_REMATCH[1]}/${project}/-/merge_requests/${number}"
   printf ' · \033]8;;%s\a!%s\033]8;;\a' "$url" "$number"
}

# How many columns the text takes up on screen, not counting color and link escapes
get_visible_width() {
   printf '%s' "$1" \
      | sed -e $'s/\033\\[[0-9;]*m//g' -e $'s/\033]8;;[^\a]*\a//g' \
      | LC_ALL=en_US.UTF-8 wc -m \
      | tr -d ' '
}

# Spaces and the session's cost, to right-align it after the given text, or " · $1.23" when
# the terminal is too narrow for that
describe_cost() {
   local text="$1" cost label gap

   cost=$(get_field .cost.total_cost_usd)
   [ -n "$cost" ] || return 0
   label=$(printf '$%.2f' "$cost")
   gap=$(( ${COLUMNS:-0} - RIGHT_MARGIN - $(get_visible_width "$text") - ${#label} ))
   if [ "$gap" -lt 2 ]; then
      printf ' · %s' "$label"
      return
   fi
   printf '%*s%s' "$gap" '' "$label"
}

describe_session() {
   local account model context

   # The config dir's name without ".claude-": ~/.claude-work is "work", and
   # ~/.claude itself is the default account
   account=$(basename "${CLAUDE_CONFIG_DIR:-$HOME/.claude}")
   account="${account#.claude}"
   account="${account#-}"
   account="${account:-Default account}"
   model=$(get_field .model.display_name)
   context=$(get_field .context_window.used_percentage)

   printf '%s · %s' "$account" "${model:-?}"
   if [ -n "$context" ]; then
      printf ' · ctx %s' "$(color_percent "${context%.*}")"
   fi
   describe_limit 5h five_hour '%-I:%M%p'
   describe_limit 7d seven_day '%a %-I%p'
   describe_review "$(get_field .workspace.current_dir)"
}

main() {
   local session

   session=$(describe_session)
   printf '%s%s\n' "$session" "$(describe_cost "$session")"
}

main
